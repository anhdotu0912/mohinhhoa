# ============================================
# P-014 — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Provider: openai | deepseek
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Optional override (DeepSeek default: https://api.deepseek.com)
# LLM_BASE_URL=https://api.deepseek.com

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ---- Database (SQLite for local/dev) ----
DATABASE_URL=sqlite:///./app.db

# ---- Vector Store (qdrant | chroma) ----
VECTOR_DB_PROVIDER=qdrant
QDRANT_PERSIST_DIR=./qdrant_db
# For Qdrant Cloud or Docker server in Production:
# QDRANT_URL=https://xyz.qdrant.tech
# QDRANT_API_KEY=your-qdrant-api-key
CHROMA_PERSIST_DIR=./chroma_db

# ---- Embedding (RAG) ----
# Primary: Gemini (below). EMBEDDING_MODEL = local fallback only (pytest / no key / API error).
EMBEDDING_PROVIDER=gemini
# Comma-separated pool — rotate on quota / 401 / 429 (tried in order).
GEMINI_API_KEY=key-1,key-2,key-3
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Auth ----
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- SMTP (quên mật khẩu) ----
# Chỉ cần email + App Password. Host Gmail mặc định trong code.
# Bọc App Password trong dấu ngoặc kép (có khoảng trắng khi copy từ Google).
SMTP_USERNAME=
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
