# ============================================
# Backend — Environment Variables
# ============================================
# Copy to backend/.env or rely on repo-root .env
# NEVER commit .env to git!

# LLM: openai | deepseek
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
DEEPSEEK_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com
# OpenAI (khi LLM_PROVIDER=openai)
OPENAI_API_KEY=
# ---- Database ----
# Dev local: sqlite:///./app.db
# Postgres (prod / external): postgresql://user:pass@host:5432/dbname
#   (provider trả postgres:// cũng được — app tự normalize sang postgresql://)
DATABASE_URL=sqlite:///./app.db
CHROMA_DIR=./chroma_db
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
