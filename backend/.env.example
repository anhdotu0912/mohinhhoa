# ============================================
# Backend — Environment Variables
# ============================================
# Copy to backend/.env or rely on repo-root .env
# NEVER commit .env to git!

# LLM: openai | deepseek
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
DEEPSEEK_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com
# OpenAI (khi LLM_PROVIDER=openai)
OPENAI_API_KEY=
# ---- Database (PostgreSQL only — ADR-005) ----
# docker-compose.yml service `postgres` (user/db `p014`, password from POSTGRES_PASSWORD):
DATABASE_URL=postgresql://p014:p014@localhost:5432/p014
POSTGRES_PASSWORD=p014
#   (provider trả postgres:// cũng được — app tự normalize sang postgresql://)
# ---- Vector Store (Qdrant only — ADR-001) ----
QDRANT_PERSIST_DIR=./qdrant_db
# For Qdrant Cloud or remote server in production:
# QDRANT_URL=https://xyz.qdrant.tech
# QDRANT_API_KEY=your-qdrant-api-key
# ---- Embedding (RAG) ----
# gemini (default) | local (offline fallback)
EMBEDDING_PROVIDER=gemini
# Comma-separated pool — rotate on quota / 401 / 429
GEMINI_API_KEY=key-1,key-2,key-3
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
# Local fallback when provider=local or Gemini unavailable
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
APP_ENV=development
# Optional — used by pytest; prefer `python -m scripts.create_demo_accounts` for local demo.
DEMO_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
# Frontend Docker build (repo root .env.example has full VPS vars)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# SMTP — quên mật khẩu: chỉ cần email + App Password (bọc trong ngoặc kép)
SMTP_USERNAME=
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
