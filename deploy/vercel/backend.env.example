# Copy to .env.vercel at the repository root. Never commit the filled file.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DATABASE?sslmode=require
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
APP_ENV=production
RAG_RETRIEVAL_MODE=keyword
AVATAR_STORAGE=database
DATABASE_POOL_MODE=null
INITIALIZE_DATABASE_ON_STARTUP=false
CORS_ORIGINS=https://mohinhhoa.vercel.app
FRONTEND_URL=https://mohinhhoa.vercel.app
# Optional: exact frontend Preview origin(s), comma-separated, in CORS_ORIGINS.
# DEMO_PASSWORD is used only when explicitly running bootstrap_cloud --with-demo.
DEMO_PASSWORD=
